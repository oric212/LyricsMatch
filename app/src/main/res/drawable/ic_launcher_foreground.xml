<?xml version="1.0" encoding="utf-8"?>
<!--
  LyricsMatch icon: a microphone next to three lyric lines; the top line is amber,
  like the line being sung. 108dp canvas, artwork inside the 66dp safe zone.
  Keep in sync with windows/tools/make-icon.ps1.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- mic head -->
    <path
        android:fillColor="@color/ic_accent"
        android:pathData="M30,42 a8,8 0 0 1 16,0 v8 a8,8 0 0 1 -16,0 z" />
    <!-- cradle, stem, base -->
    <path
        android:fillColor="#00000000"
        android:pathData="M25,50 a13,13 0 0 0 26,0 M38,63 v9 M31,73 h14"
        android:strokeWidth="4"
        android:strokeColor="@color/ic_accent"
        android:strokeLineCap="round" />
    <!-- lyric lines: the current one in amber, the next ones fading -->
    <path
        android:fillColor="#00000000"
        android:pathData="M58,42 h25"
        android:strokeWidth="6"
        android:strokeColor="@color/ic_accent"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M58,54 h18"
        android:strokeWidth="6"
        android:strokeColor="#CCFFFFFF"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M58,66 h11"
        android:strokeWidth="6"
        android:strokeColor="#73FFFFFF"
        android:strokeLineCap="round" />
</vector>
