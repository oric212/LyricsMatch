<Window x:Class="LyricsMatch.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LyricsMatch.Windows"
        Title="LyricsMatch"
        Icon="Assets/LyricsMatch.ico"
        Width="560" Height="780" MinWidth="360" MinHeight="400"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <!-- Album-coloured glow at the top fading to near-black; TintStop animates per song. -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop x:Name="TintStop" Color="#1C1828" Offset="0" />
            <GradientStop Color="#0B0A10" Offset="0.75" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: album art, song, artist, progress -->
        <StackPanel Grid.Row="0" Margin="24,18,24,0">
            <Grid x:Name="HeaderInfo">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="60" Height="60" CornerRadius="10" Background="#14FFFFFF">
                    <Grid>
                        <TextBlock Text="♪" Foreground="{StaticResource Dim}" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="ArtBorder" CornerRadius="10" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Nothing playing" Foreground="White"
                               FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ArtistText" Foreground="#99FFFFFF" FontSize="15"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <!-- Progress as a live equalizer (click to seek) -->
            <local:EqualizerBar x:Name="Eq" Height="26" Margin="0,12,0,0" Visibility="Hidden" />
        </StackPanel>

        <!-- Lyrics -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Margin="0,8,0,0">
            <!-- Soft fade at the top and bottom edges so lines ease in and out. -->
            <ScrollViewer.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0" />
                    <GradientStop Color="Black" Offset="0.12" />
                    <GradientStop Color="Black" Offset="0.85" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </ScrollViewer.OpacityMask>
            <StackPanel x:Name="LinesPanel" Margin="28,0" />
        </ScrollViewer>

        <!-- No lyrics: album art in the middle, song + artist below, live mirrored spectrum under that -->
        <StackPanel x:Name="NoLyricsPanel" Grid.Row="1" Visibility="Collapsed"
                    VerticalAlignment="Center" Margin="28,0,28,24">
            <TextBlock x:Name="NoLyricsCaption" Foreground="#99FFFFFF" FontSize="14" Margin="0,0,0,20"
                       TextAlignment="Center" />
            <Border x:Name="BigArt" Width="240" Height="240" CornerRadius="20" Background="#14FFFFFF"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="BigArtScale" />
                </Border.RenderTransform>
            </Border>
            <TextBlock x:Name="BigTitle" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,24,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="BigArtist" Foreground="#99FFFFFF" FontSize="16" TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <!-- The main progress bar on this screen: live spectrum, click to seek -->
            <local:MirrorSpectrum x:Name="Spectrum" Height="96" Margin="0,32,0,0" />
        </StackPanel>

        <!-- Status message (searching, not found, ...) -->
        <StackPanel x:Name="MessagePanel" Grid.Row="1" VerticalAlignment="Center" Margin="32">
            <TextBlock x:Name="MessageText" Foreground="{StaticResource Dim}" FontSize="20"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Text="Play a song in Spotify or any music app" />
            <TextBlock x:Name="HintText" Foreground="{StaticResource Dim}" Opacity="0.7" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>

        <!-- Sync adjustment -->
        <StackPanel x:Name="SyncBar" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,4,0,12" Visibility="Collapsed">
            <Button Content="Later" Style="{StaticResource FlatButton}" Click="Later_Click"
                    ToolTip="Lyrics are ahead of the singer" />
            <TextBlock x:Name="OffsetText" Text="In sync" Foreground="{StaticResource Dim}" FontSize="13"
                       Width="80" TextAlignment="Center" VerticalAlignment="Center" />
            <Button Content="Earlier" Style="{StaticResource FlatButton}" Click="Earlier_Click"
                    ToolTip="Lyrics are behind the singer" />
        </StackPanel>
    </Grid>
</Window>
